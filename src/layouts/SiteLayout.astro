---
import "../styles/global.css";
import "../styles/sculptural-editorial.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  pageClass?: string;
  theme?: 'editorial';
  active?: "projects" | "blog";
}

const { title, active, theme, pageClass } = Astro.props as Props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" />
    {theme === 'editorial' && <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />}
  </head>
  <body class:list={[pageClass, theme === 'editorial' ? 'sculptural-editorial' : undefined]}>
    <div class="page">
      <SiteHeader active={active} minimal={theme === 'editorial'} />
      <slot />
      <SiteFooter />
    </div>
  </body>
</html>

<style>
  :global(body.sculptural-editorial) .page {
    width: 100%;
    background: var(--color-bg);
    color: var(--color-text);
  }
</style>
