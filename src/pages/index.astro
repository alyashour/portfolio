---
import SiteLayout from '../layouts/SiteLayout.astro';
import EditorialHero from '../components/EditorialHero.astro';
import { Image } from 'astro:assets';
import transport from '../assets/images/dyn_transport.png';
import waves from '../assets/images/gernster-waves.gif';
import cubes from '../assets/images/marching-cube-demo.gif';
const projects = [
  { title: 'Dynamic Transport', subtitle:'Network design · Machine learning', image:transport, href:'/projects/dynamic-transport/', alt:'Transport network visualization', description:'Exploring how transport networks can adapt to changing demand.' },
  { title: 'Gerstner Waves', subtitle:'C++ · OpenGL', image:waves, href:'/projects/gerstner-waves/', alt:'Rendered waves on a simulated water surface', description:'Geometric shader to make realistic waves.' },
  { title: 'Marching Cubes', subtitle:'Python · OpenGL', image:cubes, href:'/projects/marching-cubes/', alt:'Surface extraction demonstration', description:'Finding form in volumetric data.' },
];
---
<SiteLayout title="Aly Ashour Portfolio" theme="editorial">
  <main>
    <EditorialHero />
    <div class="editorial-white">
      <section class="work-section" id="projects" aria-labelledby="projects-title">
        <div class="section-top">
          <div>
            <h2 id="projects-title">Selected Projects</h2>
          </div>
          <a href="/projects/">See more<span aria-hidden="true">↗</span></a></div>
        <div class="project-controls"><p class="scroll-hint" id="scroll-help">Scroll to explore</p><div><button type="button" data-project-prev aria-label="Previous project" aria-controls="project-track" disabled>←</button><button type="button" data-project-next aria-label="Next project" aria-controls="project-track">→</button></div></div>
        <div class="project-track" id="project-track" role="region" aria-label="Selected projects carousel" aria-describedby="scroll-help" tabindex="0">
        {projects.map(project=><article class="project-feature">
          <a class="project-art" href={project.href}><Image src={project.image} alt={project.alt} width={1000} loading="lazy" /></a>
          <div class="project-copy"><p class="label">{project.subtitle}</p><h3><a href={project.href}>{project.title}</a></h3><p>{project.description}</p><a class="read-link" href={project.href}>Explore project <span aria-hidden="true">↗</span></a></div>
        </article>)}
        </div>
      </section>
      <div class="material-strip" aria-hidden="true"><img src="/design-system/sculpture.jpeg" width="1024" height="768" alt="" loading="lazy" /><img src="/design-system/limestone.png" width="1536" height="1024" alt="" loading="lazy" /><img src="/design-system/sculpture.jpeg" width="1024" height="768" alt="" loading="lazy" /></div>
      <section class="blog-section" id="blog" aria-labelledby="blog-title"><div class="section-top"><div><p class="label">My Notes</p><h2 id="blog-title">Field Guide</h2></div><a href="/blog/">Click me! <span aria-hidden="true">↗</span></a></div><div class="notebook"><p class="blog-title">Blog posts are on their way.</p><p>For now, explore the project write-ups and my current reading list.</p><a class="read-link" href="/blog/">Notes &amp; reading <span aria-hidden="true">↗</span></a></div></section>
      <section class="contact-section" id="contact"><p class="label">Continue the conversation</p><h2>Let’s connect.</h2><div class="contact-links"><a href="https://github.com/alyashour">GitHub ↗</a><a href="https://www.linkedin.com/in/alymashour/">LinkedIn ↗</a></div></section>
    </div>
  </main>
</SiteLayout>
<style>
  .editorial-white { background-color:#f1e9db; background-image:linear-gradient(rgba(241,233,219,.9),rgba(241,233,219,.9)),url('/design-system/limestone.png'); background-size:auto,100% auto; color:#342a22; }
  .project-track { display:flex; gap:2rem; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-color:#796440 #e4d7c3; scrollbar-width:thin; padding-bottom:1.5rem; }
  .project-controls { display:flex; align-items:center; justify-content:space-between; margin:-1rem 0 1.5rem; }
  .scroll-hint { font-size:.75rem; color:#6c5946; }
  .project-controls > div { display:flex; gap:.5rem; }
  .project-controls button { width:44px; height:44px; border:1px solid #796440; background:transparent; color:#342a22; font-size:1.25rem; cursor:pointer; }
  .project-controls button:hover:not(:disabled) { background:#d5c4a7; }
  .project-controls button:disabled { opacity:.35; cursor:default; }
  .material-strip { display:grid; grid-template-columns:1fr 1.2fr 1fr; gap:1rem; padding:1rem; background:#d5c4a7; }
  .material-strip img { width:100%; height:240px; object-fit:cover; }
  .material-strip img:first-child { object-position:10% 85%; }
  .material-strip img:last-child { object-position:78% 60%; }
  .editorial-white a { color:inherit; text-underline-offset:.25em; }
  .editorial-white :focus-visible { outline:2px solid #342a22; outline-offset:5px; }
  .work-section,.blog-section,.contact-section { padding:5rem clamp(1.5rem,6vw,6rem); max-width:1440px; margin:auto; scroll-margin-top:2rem; }
  .section-top { display:flex; justify-content:space-between; align-items:end; gap:2rem; margin-bottom:3rem; }
  .section-top > a { font-size:.8125rem; min-height:44px; display:flex; align-items:center; gap:1.5rem; }
  .label { font-size:.625rem; letter-spacing:.17em; text-transform:uppercase; margin:0 0 1rem; color:#6c5946; }
  h2 { font-family:'Anton',Impact,sans-serif; text-transform:uppercase; font-size:clamp(2.5rem,5vw,4.5rem); font-weight:400; line-height:1.1; margin:0; }
  .project-feature { display:grid; grid-template-columns:1.3fr 1fr; flex:0 0 88%; min-width:0; scroll-snap-align:start; background:#f1e9db; }
  .project-art { display:block; overflow:hidden; background:#241e19; }
  .project-art img { width:100%; height:100%; aspect-ratio:1.5; object-fit:contain; display:block; }
  .project-copy { align-self:center; padding:clamp(1.5rem,4vw,4rem); }
  h3 { font-family:'Anton',Impact,sans-serif; font-size:clamp(2rem,3.5vw,3.25rem); line-height:1.1; font-weight:400; margin:0 0 1.25rem; text-transform:uppercase; }
  h3 a { text-decoration:none; }
  h3 a:hover { text-decoration:underline; }
  .project-copy > p:not(.label) { font-size:.875rem; line-height:1.8; max-width:32ch; color:#6c5946; }
  .read-link { display:inline-flex; align-items:center; gap:2rem; min-height:44px; font-size:.75rem; margin-top:1rem; }
  .notebook { border-block:1px solid #c4b49e; padding:2.5rem 0; }
  .blog-title { font-size:1.5rem; margin:0 0 1rem; }
  .notebook > p:not(.blog-title) { color:#6c5946; font-size:.875rem; }
  .contact-section { padding-top:2rem; padding-bottom:5rem; }
  .contact-links { display:flex; flex-wrap:wrap; gap:2rem; margin-top:1.5rem; }
  .contact-links a { min-height:44px; display:inline-flex; align-items:center; }
  @media(max-width:767px) {
    .material-strip { gap:.5rem; padding:.5rem; }
    .material-strip img { height:140px; }
    .work-section,.blog-section,.contact-section { padding-block:3rem; }
    .section-top { align-items:start; flex-direction:column; gap:1rem; margin-bottom:2rem; }
    .project-feature { grid-template-columns:1fr; flex-basis:88%; }
    .project-track { gap:1rem; }
    .project-art img { aspect-ratio:1.4; }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('#project-track');
  const previous = document.querySelector<HTMLButtonElement>('[data-project-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-project-next]');
  if (track && previous && next) {
    const update = () => {
      previous.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    };
    const move = (direction: number) => {
      const items = [...track.querySelectorAll<HTMLElement>('.project-feature')];
      const positions = items.map(item => item.offsetLeft - items[0].offsetLeft);
      const target = direction > 0 ? positions.find(pos => pos > track.scrollLeft + 4) : positions.reverse().find(pos => pos < track.scrollLeft - 4);
      track.scrollTo({left: target ?? (direction > 0 ? track.scrollWidth : 0), behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'});
    };
    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    track.addEventListener('scroll', update, {passive:true});
    new ResizeObserver(update).observe(track);
    update();
  }
</script>
