---
import SiteLayout from "../../layouts/SiteLayout.astro";
import CollectionHero from "../../components/CollectionHero.astro";
import "../../styles/collections.css";
import ProjectCard from "../../components/ProjectCard.astro";
import dynTransport from "../../assets/images/dyn_transport.png";
import gerstnerWaves from "../../assets/images/gernster-waves.gif";
import marchingCubes from "../../assets/images/marching-cube-demo.gif";
import bezierCurve from "../../assets/images/bezier-demo.gif";
---

<SiteLayout title="Projects — Aly Ashour" active="projects" theme="editorial">
  <main>
    <CollectionHero eyebrow="Engineering / Explorations" title="ALL PROJECTS" description="Experiments in graphics, intelligent systems, and the physical world." />
    <section class="collection-surface" aria-label="Project collection">
    <div class="collection-inner">
    <div class="filter-bar" role="group" aria-label="Filter projects by technology">
      <button class="filter-btn is-active" data-filter-btn data-tag="All"
        >All</button
      >
      <button class="filter-btn" data-filter-btn data-tag="OpenGL"
        >OpenGL</button
      >
      <button class="filter-btn" data-filter-btn data-tag="C++">C++</button>
      <button class="filter-btn" data-filter-btn data-tag="Python"
        >Python</button
      >
      <button
        class="filter-btn"
        data-filter-btn
        data-tag="Machine Learning">Machine Learning</button
      >
    </div>
    <p class="collection-count" aria-live="polite" data-count>4 projects</p>
    <div id="project-grid" class="project-grid-full">
      <ProjectCard
        href="/projects/dynamic-transport/"
        image={dynTransport}
        imageAlt="Dynamic Transport Network Design System"
        title="Dynamic Transport Network Design System"
        tags={["Python", "Machine Learning"]}
        description="A data-driven look at transit network design — modeling routes and stops for a city transport system and visualizing the result in 3D."
        githubUrl="https://github.com/alyashour/Dyn-Transport-Route-Design-System"
        filterTags="Python,Machine Learning"
        priority
      />
      <ProjectCard
        href="/projects/gerstner-waves/"
        image={gerstnerWaves}
        imageAlt="Gerstner Waves Water Shader"
        title="Gerstner Waves Water Shader"
        tags={["C++", "OpenGL"]}
        description="A real-time ocean surface shader using the Gerstner wave model to animate a physically plausible water surface."
        githubUrl="https://github.com/alyashour/Gerstner-waves"
        filterTags="C++,OpenGL"
        priority
      />
      <ProjectCard
        href="/projects/marching-cubes/"
        image={marchingCubes}
        imageAlt="Marching Cubes Surface Extraction"
        title="Marching Cubes Surface Extraction"
        tags={["Python", "OpenGL"]}
        description="An implementation of marching cubes, extracting a polygonal surface from a 3D scalar field and rendering it in OpenGL."
        githubUrl="https://github.com/alyashour/Marching-Cube-Renderer"
        filterTags="Python,OpenGL"
        priority
      />
      <ProjectCard
        href="/projects/bezier-curve/"
        image={bezierCurve}
        imageAlt="Bezier Curve Editor"
        title="Bezier Curve Editor"
        tags={["Python", "OpenGL"]}
        description="An interactive editor for constructing and manipulating Bezier curves by hand."
        githubUrl="https://github.com/alyashour/Bezier-Curve-Editor"
        priority
        filterTags="Python,OpenGL"
      />
    </div>
    </div>
    </section>
  </main>
</SiteLayout>

<script>
  const buttons = document.querySelectorAll("[data-filter-btn]");
  const cards = document.querySelectorAll("[data-card]");

  buttons.forEach((btn) => {
    btn.setAttribute("aria-pressed", String(btn.getAttribute("data-tag") === "All"));
    btn.addEventListener("click", () => {
      const tag = btn.getAttribute("data-tag");
      buttons.forEach((b) => {
        const active = b.getAttribute("data-tag") === tag;
        b.classList.toggle("is-active", active);
        b.setAttribute("aria-pressed", String(active));
      });
      cards.forEach((card) => {
        const tags = (card.getAttribute("data-tags") ?? "").split(",");
        card.classList.toggle(
          "is-hidden",
          !(tag === "All" || tags.includes(tag ?? "")),
        );
      });
      const count = [...cards].filter(card => !card.classList.contains("is-hidden")).length;
      const status = document.querySelector("[data-count]");
      if (status) status.textContent = `${count} ${count === 1 ? "project" : "projects"}`;
    });
  });
</script>
