---
interface Props { eyebrow: string; title: string; description: string; image?: string; overlay?: string | null; imageWidth?: number; imageHeight?: number; }
const { eyebrow, title, description, image = "/design-system/editorial-photo-v2.png", overlay = "/design-system/perception-atelier-overlay.svg", imageWidth = 1536, imageHeight = 1024 } = Astro.props;
---
<section class="collection-cover">
  <img src={image} alt="" aria-hidden="true" width={imageWidth} height={imageHeight} />
  {overlay && <img src={overlay} alt="" aria-hidden="true" width={imageWidth} height={imageHeight} />}
  <div class="collection-cover-copy">
    <p>{eyebrow}</p>
    <h1>{title}</h1>
    <div class="collection-description">{description}</div>
  </div>
</section>
<style>
  .collection-cover { position:relative; isolation:isolate; min-height:530px; display:flex; align-items:end; background:var(--collection-cover-bg,#160f09); overflow:hidden; }
  img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:var(--collection-image-position,right 38%); z-index:-2; }
  .collection-cover::after { content:""; position:absolute; inset:0; z-index:-1; background:var(--collection-cover-fade,linear-gradient(90deg,rgba(22,15,9,.82),rgba(22,15,9,.18) 80%),linear-gradient(0deg,#241e19,transparent 55%)); }
  .collection-cover-copy { padding:140px clamp(1.5rem,5vw,5rem) 64px; width:100%; }
  p { text-transform:uppercase; font-size:11px; letter-spacing:.22em; margin:0 0 24px; }
  h1 { font-family:Anton,Impact,sans-serif; font-weight:400; font-size:clamp(4rem,10vw,10rem); line-height:1; margin:0 0 28px; max-width:9ch; }
  .collection-description { font-size:16px; line-height:1.7; max-width:39ch; color:var(--collection-description-color,#d5c4a7); }
  @media(max-width:650px) { .collection-cover { min-height:490px; } img { object-position:var(--collection-image-position-mobile,65% center); } h1 { font-size:clamp(3.6rem,16vw,6rem); } .collection-cover-copy { padding-bottom:48px; } }
</style>
