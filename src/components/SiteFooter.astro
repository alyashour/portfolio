---
import { version } from "../../package.json";
---

<footer class="site-footer">
  <span>v{version}</span>
  <p class="image-disclaimer">All images are taken by Aly Ashour and may be enhanced by AI for sharpness or color.</p>
  <a href="https://github.com/alyashour/portfolio">Source <span aria-hidden="true">↗</span></a>
</footer>

<style>
  .site-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px clamp(1.5rem,5vw,5rem);
    gap: 12px 24px;
    flex-wrap: wrap;
    border-top: 1px solid var(--color-border);
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .image-disclaimer {
    flex: 1 1 320px;
    margin: 0;
    line-height: 1.6;
    max-width: 65ch;
  }

  .site-footer a {
    color: var(--color-text-muted);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
  }
</style>
