---
import { Image } from 'astro:assets';
import dynTransport from '../assets/images/dyn_transport.png';
import mnistLecture from '../assets/images/mnist_lecture.jpg';
import waves from '../assets/images/gernster-waves.gif';
const projects = [
  {title:'Dynamic Transport', label:'Machine learning · Networks', href:'/projects/dynamic-transport/', image:dynTransport, alt:'Transport network visualization'},
  {title:'Learning, together', label:'WE Autopilot · Education', href:'#experience', image:mnistLecture, alt:'Aly teaching digit classification at WE Autopilot'},
  {title:'Gerstner Waves', label:'C++ · OpenGL', href:'/projects/gerstner-waves/', image:waves, alt:'Water surface rendered with a Gerstner waves shader'},
];
---
<section id="about" class="gallery-hero" aria-labelledby="hero-title">
  <div class="hero-stage">
    <img class="sculpture" src="/design-system/sculpture.jpeg" alt="Classical marble sculpture in warm museum light." width="1024" height="768" fetchpriority="high" />
    <div class="hero-copy">
      <p class="chapter"><span>01</span><span class="line" aria-hidden="true"></span></p>
      <h1 id="hero-title">Selected<br /><span>work</span></h1>
      <p class="role">Aly Ashour · Robotics engineering</p>
      <p class="description">Software, sensing, and the art of making things.</p>
      <a class="work-link" href="#projects">Explore my work <span aria-hidden="true">↓</span></a>
    </div>

  </div>
  <div class="work-strip" aria-label="Selected work">
    {projects.map((p,i)=><a class="work" href={p.href}>
      <div class="work-image"><Image src={p.image} alt={p.alt} width={560} loading="lazy" /></div>
      <div class="caption"><span class="number">0{i+1}</span><span class="rule" aria-hidden="true"></span><h2>{p.title}</h2><span class="arrow" aria-hidden="true">↗</span></div>
      <p class="work-meta">{p.label}</p>
    </a>)}
  </div>
</section>
<style>
  .gallery-hero { width:100%; }
  .hero-stage { position:relative; height:clamp(460px,41vw,620px); isolation:isolate; }
  .sculpture { position:absolute; right:0; top:0; width:69%; height:100%; object-fit:cover; object-position:35% 24%; z-index:-1; }
  .hero-copy { position:relative; width:56%; padding:clamp(3rem,5.5vw,5.5rem) 0 2rem clamp(1.5rem,4vw,4rem); }
  .chapter { display:flex; align-items:center; gap:.875rem; font-size:.6rem; text-transform:uppercase; letter-spacing:.16em; color:var(--sg-muted); margin:0 0 1.5rem; }
  .chapter > span:first-child { font:400 .875rem var(--sg-font-display); }
  .chapter > span:last-child { max-width:15ch; }
  .line { width:2rem; height:1px; background:var(--sg-rule); }
  h1 { font:400 clamp(5rem,8.5vw,9rem)/.89 var(--sg-font-display); letter-spacing:-.065em; margin:0 0 2.5rem; }
  h1 span { display:inline-block; padding-top:.1em; }
  .role { font-size:.6rem; letter-spacing:.14em; text-transform:uppercase; margin:0 0 .75rem; max-width:25ch; }
  .description { max-width:23ch; font-size:.75rem; color:var(--sg-muted); margin:0 0 1rem; }
  .work-link { display:inline-flex; min-height:44px; align-items:center; gap:2rem; font-size:.6875rem; text-decoration:none; }
  .work-link:hover { text-decoration:underline; }
  .work-strip { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.25rem; padding:1.5rem 2rem 1.25rem; }
  .work { text-decoration:none; min-width:0; }
  .work-image { background:var(--sg-limestone); aspect-ratio:2.7/1; overflow:hidden; }
  .work-image img { display:block; width:100%; height:100%; object-fit:cover; transition:transform 400ms ease; }
  .caption { display:flex; gap:.75rem; align-items:baseline; margin-top:.875rem; }
  .number { font:400 .8125rem var(--sg-font-display); }
  .rule { align-self:center; width:1.75rem; height:1px; background:var(--sg-rule); flex-shrink:0; }
  h2 { font:400 clamp(1rem,1.4vw,1.25rem)/1.2 var(--sg-font-display); margin:0; }
  .arrow { margin-left:auto; }
  .work-meta { margin:.4rem 0 0; font-size:.6rem; letter-spacing:.04em; color:var(--sg-muted); }
  .work:hover h2 { text-decoration:underline; text-underline-offset:.2em; }
  .work:hover img { transform:scale(1.025); }
  @media (max-width:767px) {
    .hero-stage { height:580px; }
    .sculpture { width:100%; height:100%; object-position:32% top; }
    .hero-copy { position:absolute; left:0; bottom:0; width:100%; padding:2rem 1.5rem; background:linear-gradient(0deg,rgba(241,233,219,.98) 0%,rgba(241,233,219,.94) 60%,rgba(241,233,219,0) 100%); }
    .chapter { margin-bottom:1rem; }
    h1 { font-size:clamp(4.75rem,19vw,7rem); margin-bottom:1.5rem; }
    .role { max-width:none; }
    .description { display:none; }
    .work-strip { grid-template-columns:1fr; gap:0; padding:.25rem 1.25rem; }
    .work { display:grid; grid-template-columns:80px 1fr; gap:0 1rem; padding:1rem 0; border-bottom:1px solid var(--sg-rule); }
    .work:last-child { border-bottom:0; }
    .work-image { grid-row:1/3; aspect-ratio:1; }
    .caption { margin:.5rem 0 0; gap:.5rem; }
    .rule { width:1rem; }
    .work-meta { grid-column:2; margin-top:.5rem; }
  }
  @media (prefers-reduced-motion:reduce) { .work:hover img { transform:none; } }
</style>
