---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  href: string;
  image: ImageMetadata;
  imageAlt: string;
  title: string;
  tags: string[];
  description: string;
  githubUrl: string;
}

const { href, image, imageAlt, title, tags, description, githubUrl } =
  Astro.props as Props;
---

<div data-card data-tags={tags.join(",")}>
  <a href={href} class="project-card-link">
    <Image
      src={image}
      alt={imageAlt}
      width={640}
      loading="eager"
      fetchpriority="high"
      class="thumb project-card-img"
    />
    <h3 class="project-card-title">{title}</h3>
  </a>
  <div class="badge-row">
    {tags.map((tag) => <span class="badge">{tag}</span>)}
  </div>
  <p class="project-card-desc">{description}</p>
  <a href={githubUrl} class="project-card-github">View on GitHub →</a>
</div>

<style>
  .project-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .project-card-img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    margin-bottom: 12px;
  }

  .project-card-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 21px;
    margin: 0 0 6px;
  }

  .project-card-desc {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0 0 10px;
  }

  .project-card-github {
    font-size: 13px;
    color: var(--color-accent);
  }
</style>
