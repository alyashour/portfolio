---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  href: string;
  image: ImageMetadata;
  imageAlt: string;
  title: string;
  tags: string[];
  description: string;
  githubUrl: string;
}

const { href, image, imageAlt, title, tags, description, githubUrl } =
  Astro.props as Props;
---

<div data-card data-tags={tags.join(",")}>
  <a href={href} class="project-card-link">
    <Image
      src={image}
      alt={imageAlt}
      width={640}
      loading="eager"
      fetchpriority="high"
      class="project-card-img"
    />
    <h3 class="project-card-title">{title}</h3>
  </a>
  <div class="badge-row">
    {tags.map((tag) => <span class="badge">{tag}</span>)}
  </div>
  <p class="project-card-desc">{description}</p>
  <a href={githubUrl} class="project-card-github">View on GitHub →</a>
</div>

<style>
  .project-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .project-card-img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: contain;
    margin-bottom: 24px;
    filter: none;
    border: 0;
    border-radius: 0;
    outline: 1px solid var(--color-border-strong);
    background: var(--project-card-image-bg);
  }

  .project-card-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    text-transform: uppercase;
    line-height: 1.15;
    margin: 0 0 18px;
  }

  .badge-row {
    gap: 18px;
    margin-bottom: 16px;
  }

  .badge {
    background: transparent;
    color: var(--color-text-secondary);
    border: 0;
    border-radius: 0;
    padding: 0;
    text-transform: uppercase;
    letter-spacing: .1em;
    font-size: 10px;
  }

  .project-card-desc {
    font-size: 14.5px;
    line-height: 1.8;
    max-width: 48ch;
    color: var(--color-text-secondary);
    margin: 0 0 10px;
  }

  .project-card-github {
    font-size: 13px;
    color: var(--color-accent);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    border-bottom: 1px solid var(--color-border);
    border-color: var(--color-border);
  }

  .is-hidden { display: none; }
</style>
